<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
    <link rel="stylesheet" href="/public/css/styles.css" />
    <style>
      /* PDF Review Modal Specifics */
      .pdf-review-list {
        max-height: 350px;
        overflow-y: auto;
        border: 1px solid var(--line);
        border-radius: var(--radius-md);
        margin: 16px 0;
        background: var(--bg-soft);
      }

      .pdf-domain-item {
        display: flex;
        align-items: center;
        padding: 8px 12px;
        border-bottom: 1px solid var(--line);
        gap: 10px;
        transition: var(--transition);
      }

      .pdf-domain-item:last-child { border-bottom: none; }
      .pdf-domain-item:hover { background: #fff; }

      .pdf-domain-item input[type="checkbox"] { width: 16px; height: 16px; cursor: pointer; }
      .pdf-domain-item label { flex: 1; cursor: pointer; font-size: 0.9rem; color: var(--text); }

      #pdf-loading-overlay {
        position: absolute;
        inset: 0;
        background: rgba(255,255,255,0.85);
        display: none;
        align-items: center;
        justify-content: center;
        flex-direction: column;
        z-index: 10;
        border-radius: inherit;
      }

      .skeleton-loader {
        background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
        background-size: 200% 100%;
        animation: skeleton-loading 1.5s infinite;
        border-radius: 4px;
      }

      @keyframes skeleton-loading {
        0% { background-position: 200% 0; }
        100% { background-position: -200% 0; }
      }

      .files-container:hover {
        border-color: var(--line-strong) !important;
        background: #fdfdfd;
      }
      .files-container::-webkit-scrollbar { width: 4px; }
      .files-container::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 4px; }

      /* Compact Table styling to prevent horizontal scrollbar */
      #notices-table th, 
      #notices-table td {
        padding: 6px 8px;
        font-size: 0.8rem;
        vertical-align: middle;
      }
      #notices-table th {
        font-size: 0.72rem;
        white-space: nowrap;
      }
      .btn-action-compact {
        padding: 3px 6px !important;
        font-size: 0.72rem !important;
        height: auto !important;
        line-height: 1.2 !important;
      }
    </style>
  </head>
  <body class="app-layout bg-grid">
    <%- include('partials/sidebar', { activePage: 'notices' }) %>
    <div class="main-content">
      <%- include('partials/topbar', { pageTitle: 'Ofícios Cadastrados', pageSubtitle: 'Gerenciamento de Ofícios e Anexos' }) %>

      <main class="content-wrap">
      <% if (typeof flash !== 'undefined' && flash && flash.text) { %>
        <div class="flash-banner <%= flash.type %>" style="margin-bottom:18px;padding:14px 22px;border-radius:7px;font-size:1.08em;font-weight:500;box-shadow:0 2px 8px #0001; background:<%= flash.type === 'success' ? '#e6ffed' : '#fff4e6' %>;color:<%= flash.type === 'success' ? '#155724' : '#a15c00' %>;border:1.5px solid <%= flash.type === 'success' ? '#b7f5c2' : '#ffd699' %>;text-align:center;transition:all .3s;">
          <%= flash.text %>
        </div>
        <script>
          setTimeout(() => {
            const banner = document.querySelector('.flash-banner');
            if (banner) banner.style.display = 'none';
          }, 3500);
        </script>
      <% } %>

      <section class="cards-grid" style="margin-bottom: 24px;">
        <article class="metric-card">
          <p>Total de Ofícios</p>
          <h2><%= totals.total %></h2>
        </article>
        <article class="metric-card">
          <p>Ofícios Bloqueados</p>
          <h2 style="color: #f59e0b;"><%= totals.blocked %></h2>
        </article>
        <article class="metric-card">
          <p>Ofícios Desbloqueados</p>
          <h2 style="color: var(--info);"><%= totals.unblocked %></h2>
        </article>
        <article class="metric-card">
          <p>Ofícios Respondidos</p>
          <h2 style="color: var(--success);"><%= totals.informed %></h2>
        </article>
      </section>
      <section class="table-section">
        <div class="table-header">
          <h3>Ofícios Cadastrados</h3>
          <div style="display: flex; gap: 20px; align-items: center;">
            <div class="status-legend" style="display: flex; gap: 12px; font-size: 0.85rem; background: var(--bg-soft); padding: 6px 12px; border-radius: var(--radius-sm); border: 1px solid var(--line);">
              <div style="display: flex; align-items: center; gap: 6px;"><span style="width: 8px; height: 8px; border-radius: 50%; background: var(--muted);"></span> Cadastrado</div>
              <div style="display: flex; align-items: center; gap: 6px;"><span style="width: 8px; height: 8px; border-radius: 50%; background: #f59e0b;"></span> Bloqueado</div>
              <div style="display: flex; align-items: center; gap: 6px;"><span style="width: 8px; height: 8px; border-radius: 50%; background: var(--info);"></span> Desbloqueado</div>
              <div style="display: flex; align-items: center; gap: 6px;"><span style="width: 8px; height: 8px; border-radius: 50%; background: var(--success);"></span> Respondido</div>
            </div>
            <% if (hasPermission('notices.create')) { %>
              <button id="btn-add-notice" class="btn-primary">Cadastrar novo ofício</button>
            <% } %>
          </div>
        </div>

        <!-- Modal de cadastro de ofício -->
        <div id="modal-add-notice" class="modal" style="display:none;position:fixed;z-index:1000;left:0;top:0;width:100vw;height:100vh;background:rgba(0,0,0,0.35);align-items:center;justify-content:center;">
          <div class="modal-content" style="background:#fff;padding:32px 24px 24px 24px;border-radius:8px;min-width:320px;max-width:95vw;max-height:95vh;overflow-y:auto;box-shadow:0 2px 16px #0002;position:relative;">
            <button id="close-modal-add-notice" style="position:absolute;top:8px;right:12px;background:none;border:none;font-size:1.5rem;cursor:pointer;">&times;</button>
            <h2 style="margin-top:0;margin-bottom:18px;">Cadastrar novo ofício</h2>
            <form id="form-add-notice" method="post" action="/notices" enctype="multipart/form-data" class="form-stack" style="gap:10px;">
              <label for="noticeCode">Número do Ofício <span style="color:var(--danger);">*</span></label>
              <input id="noticeCode" name="noticeCode" type="text" placeholder="Ex.: Ofício 123/2026" required />
              
              <div style="display:flex; gap:12px;">
                <div style="flex:1;">
                  <label for="processNumber">Número do Processo</label>
                  <input id="processNumber" name="processNumber" type="text" placeholder="Ex.: 1234567-89.2026.8.26.0000" />
                </div>
                <div style="flex:1;">
                  <label for="requestingOrgan">Órgão Solicitante</label>
                  <input id="requestingOrgan" name="requestingOrgan" type="text" placeholder="Ex.: Tribunal de Justiça" />
                </div>
              </div>

              <label for="noticeName">Nome do Ofício <span style="color:var(--danger);">*</span></label>
              <input id="noticeName" name="noticeName" type="text" placeholder="Nome do ofício" required />
              
              <div style="display:flex; gap:12px;">
                <div style="flex:1;">
                  <label for="blockStartDate">Início do Bloqueio (opcional)</label>
                  <input id="blockStartDate" name="blockStartDate" type="date" />
                </div>
                <div style="flex:1;">
                  <label for="blockEndDate">Término do Bloqueio (opcional)</label>
                  <input id="blockEndDate" name="blockEndDate" type="date" />
                </div>
              </div>

              <div style="margin: 10px 0;">
                <label style="font-weight:600; display:block; margin-bottom:8px;">Tipo do Ofício:</label>
                <div style="display:flex; gap:20px;">
                  <label style="display:flex; align-items:center; gap:8px; cursor:pointer;">
                    <input type="radio" name="noticeType" value="block" checked style="width:18px; height:18px;"> Bloqueio
                  </label>
                  <label style="display:flex; align-items:center; gap:8px; cursor:pointer;">
                    <input type="radio" name="noticeType" value="unblock" style="width:18px; height:18px;"> Desbloqueio
                  </label>
                </div>
              </div>

              <label for="noticeFile">Arquivos do Ofício (opcional)</label>
              <input id="noticeFile" name="noticeFile" type="file" accept=".pdf,.doc,.docx,.jpg,.jpeg,.png" multiple />
              <div style="display:flex;gap:12px;margin-top:10px;">
                <button type="submit" class="btn-primary">Salvar Ofício</button>
                <button type="button" id="cancel-modal-add-notice" class="btn-secondary">Cancelar</button>
              </div>
            </form>
          </div>
        </div>

        <!-- Modal de edição de ofício -->
        <div id="modal-edit-notice" class="modal" style="display:none;position:fixed;z-index:1000;left:0;top:0;width:100vw;height:100vh;background:rgba(0,0,0,0.35);align-items:center;justify-content:center;">
          <div class="modal-content" style="background:#fff;padding:32px 24px 24px 24px;border-radius:8px;min-width:350px;max-width:95vw;max-height:95vh;overflow-y:auto;box-shadow:0 2px 16px #0002;position:relative;">
            <button id="close-modal-edit-notice" style="position:absolute;top:8px;right:12px;background:none;border:none;font-size:1.5rem;cursor:pointer;">&times;</button>
            <h2 style="margin-top:0;margin-bottom:18px;">Editar ofício</h2>
            <form id="form-edit-notice" method="post" action="" class="form-stack" style="gap:10px;">
              <label for="editNoticeCode">Número do Ofício <span style="color:var(--danger);">*</span></label>
              <input id="editNoticeCode" name="noticeCode" type="text" placeholder="Ex.: Ofício 123/2026" required />
              
              <div style="display:flex; gap:12px;">
                <div style="flex:1;">
                  <label for="editProcessNumber">Número do Processo</label>
                  <input id="editProcessNumber" name="processNumber" type="text" placeholder="Ex.: 1234567-89.2026.8.26.0000" />
                </div>
                <div style="flex:1;">
                  <label for="editRequestingOrgan">Órgão Solicitante</label>
                  <input id="editRequestingOrgan" name="requestingOrgan" type="text" placeholder="Ex.: Tribunal de Justiça" />
                </div>
              </div>

              <label for="editNoticeName">Nome do Ofício <span style="color:var(--danger);">*</span></label>
              <input id="editNoticeName" name="noticeName" type="text" placeholder="Nome do ofício" required />
              
              <div style="display:flex; gap:12px;">
                <div style="flex:1;">
                  <label for="editBlockStartDate">Início do Bloqueio (opcional)</label>
                  <input id="editBlockStartDate" name="blockStartDate" type="date" />
                </div>
                <div style="flex:1;">
                  <label for="editBlockEndDate">Término do Bloqueio (opcional)</label>
                  <input id="editBlockEndDate" name="blockEndDate" type="date" />
                </div>
              </div>

              <div style="margin: 10px 0;">
                <label style="font-weight:600; display:block; margin-bottom:8px;">Tipo do Ofício:</label>
                <div style="display:flex; gap:20px;">
                  <label style="display:flex; align-items:center; gap:8px; cursor:pointer;">
                    <input type="radio" id="editNoticeTypeBlock" name="noticeType" value="block" style="width:18px; height:18px;"> Bloqueio
                  </label>
                  <label style="display:flex; align-items:center; gap:8px; cursor:pointer;">
                    <input type="radio" id="editNoticeTypeUnblock" name="noticeType" value="unblock" style="width:18px; height:18px;"> Desbloqueio
                  </label>
                </div>
              </div>

              <div style="display:flex;gap:12px;margin-top:10px;">
                <button type="submit" class="btn-primary">Salvar Alterações</button>
                <button type="button" id="cancel-modal-edit-notice" class="btn-secondary">Cancelar</button>
              </div>
            </form>
          </div>
        </div>

        <form method="get" action="/notices" class="table-controls" style="display:flex;gap:12px;align-items:flex-end;margin-bottom:12px;">
          <div style="flex:2;min-width:220px;max-width:400px;">
            <label for="search-input" style="margin-bottom: 4px;">Buscar Ofício</label>
            <input type="text" name="search" id="search-input" value="<%= search || '' %>" placeholder="Número, processo ou órgão..." style="padding:8px 12px;font-size:1rem;" autocomplete="off" />
          </div>
          <div>
            <label for="notices-page-size" style="margin-bottom: 4px;">Exibir</label>
            <select id="notices-page-size" style="padding:8px 12px;">
              <option value="5" selected>5</option>
              <option value="10">10</option>
              <option value="25">25</option>
              <option value="50">50</option>
            </select>
          </div>
          <button type="submit" class="btn-secondary" style="height: 42px;">Buscar</button>
        </form>

        <div class="table-container">
          <table id="notices-table">
            <thead>
              <tr>
                <th style="width: 140px;">Número do Ofício</th>
                <th style="width: 130px;">Processo</th>
                <th style="width: 140px;">Órgão Solicitante</th>
                <th style="min-width: 200px;">Nome do Ofício / Anexos</th>
                <th style="width: 90px; text-align: center;">Tipo</th>
                <th style="width: 110px;">Cadastro</th>
                <th style="width: 90px;">Por</th>
                <th style="width: 80px; text-align: center;">Alvos</th>
                <th style="width: 100px; text-align: center;">Status</th>
                <th style="width: 220px; text-align: center;">Ações</th>
              </tr>
            </thead>
            <tbody id="notices-body">
              <% if (!notices || notices.length === 0) { %>
                <tr>
                  <td colspan="10">Nenhum ofício cadastrado.</td>
                </tr>
              <% } else { %>
                <% notices.forEach(function (notice) { %>
                  <tr class="status-<%= notice.status || 'registered' %> data-row">
                    <td style="word-break: break-word; white-space: normal; line-height: 1.3;"><%= notice.notice_code %></td>
                    <td style="word-break: break-all; white-space: normal; line-height: 1.3;"><%= notice.process_number || '-' %></td>
                    <td style="word-break: break-word; white-space: normal; line-height: 1.3;"><%= notice.requesting_organ || '-' %></td>
                    <td>
                      <div style="font-weight: 600; margin-bottom: 6px; word-break: break-word; white-space: normal; line-height: 1.3;" title="<%= notice.original_file_name %>">
                        <%= notice.original_file_name %>
                      </div>
                      <% if (notice.files && notice.files.length > 0) { %>
                        <div style="max-height: 60px; overflow-y: auto; display: flex; flex-wrap: wrap; gap: 4px; padding: 4px; border: 1px solid var(--line); border-radius: 6px; background: var(--bg-soft);" class="files-container">
                          <% notice.files.forEach(function(file, idx) { %>
                            <span style="display:inline-flex;align-items:center;gap:2px;">
                              <a href="/notices/<%= notice.id %>/download/<%= file.id %>" class="btn-secondary" style="font-size:0.75rem; padding:1px 6px; white-space: nowrap; border-radius: 4px 0 0 4px; height: 22px; display: inline-flex; align-items: center;" title="<%= file.original_file_name %>">
                                <%= file.original_file_name.length > 15 ? file.original_file_name.slice(0, 12) + '...' : file.original_file_name %>
                              </a>
                              <% if (!notice.status || notice.status === 'registered') { %>
                                <button class="btn-delete-file" data-notice-id="<%= notice.id %>" data-file-id="<%= file.id %>" data-file-name="<%= file.original_file_name %>" title="Excluir anexo" style="background:var(--danger);color:#fff;border:none;border-radius:0 4px 4px 0;height:22px;padding:0 5px;cursor:pointer;font-size:0.75rem;line-height:1;">×</button>
                              <% } %>
                            </span>
                          <% }) %>
                        </div>
                      <% } else { %>
                        <div style="opacity: 0.5; font-size: 0.8rem; font-style: italic;">Nenhum anexo</div>
                      <% } %>
                    </td>
                    <td style="text-align:center;">
                      <% if (notice.notice_type === 'unblock') { %>
                        <span class="badge" style="background:#e0f2fe; color:#0369a1; border:1px solid #bae6fd; font-size: 0.85rem;">Desbloqueio</span>
                      <% } else { %>
                        <span class="badge" style="background:#fef3c7; color:#92400e; border:1px solid #fde68a; font-size: 0.85rem;">Bloqueio</span>
                      <% } %>
                    </td>
                    <td style="font-size: 0.85rem;"><%= new Date(notice.created_at).toLocaleDateString('pt-BR') %><br><span style="opacity: 0.6; font-size: 0.8rem;"><%= new Date(notice.created_at).toLocaleTimeString('pt-BR', {hour: '2-digit', minute:'2-digit'}) %></span></td>
                    <td style="font-size: 0.85rem; max-width: 100px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;"><%= notice.username || '-' %></td>
                    <td style="text-align:center;">
                      <div style="display: flex; flex-direction: column; gap: 2px; align-items: center;">
                        <div style="font-size: 0.75rem; color: var(--brand); font-weight: 700; white-space: nowrap;">
                          <%= notice.total_domains %> <span style="font-weight: 400; opacity: 0.8;">Domínios</span>
                        </div>
                        <div style="font-size: 0.75rem; color: #6366f1; font-weight: 700; white-space: nowrap;">
                          <%= notice.total_ips %> <span style="font-weight: 400; opacity: 0.8;">IPs</span>
                        </div>
                      </div>
                    </td>
                    <td style="text-align:center;">
                      <% if (notice.status === 'informed') { %>
                        <span class="badge badge-success" title="Respondido em: <%= notice.informed_at ? new Date(notice.informed_at).toLocaleString('pt-BR') : '-' %>">Respondido</span>
                      <% } else if (notice.status === 'unblocked') { %>
                        <span class="badge badge-info">Desbloqueado</span>
                      <% } else if (notice.status === 'blocked') { %>
                        <span class="badge badge-warning">Bloqueado</span>
                      <% } else { %>
                        <span class="badge badge-secondary">Cadastrado</span>
                      <% } %>
                    </td>
                    <td style="text-align:center;">
                      <div style="display:flex;flex-direction:column;gap:6px;justify-content:center;align-items:center;">
                        <% if (notice.status !== 'informed') { %>
                          <div style="display:flex;gap:6px;flex-direction:column;width:100%;">
                            <div style="display:flex;gap:4px;flex-wrap:wrap;justify-content:center;">
                              <% if (hasPermission('notices.add_domains')) { %>
                                <button class="btn-primary btn-add-domains btn-action-compact" 
                                        data-notice-id="<%= notice.id %>" 
                                        data-notice-code="<%= notice.notice_code %>"
                                        data-notice-type="<%= notice.notice_type || 'block' %>"
                                        style="flex:1;white-space:nowrap;">+ Domínios</button>
                                <button class="btn-primary btn-add-ips btn-action-compact" 
                                        data-notice-id="<%= notice.id %>" 
                                        data-notice-code="<%= notice.notice_code %>"
                                        data-notice-type="<%= notice.notice_type || 'block' %>"
                                        style="flex:1;background:#6366f1;border-color:#6366f1;white-space:nowrap;">+ IPs</button>
                              <% } %>
                              <% if (hasPermission('notices.add_files')) { %>
                                <button class="btn-secondary btn-add-files btn-action-compact" data-notice-id="<%= notice.id %>" data-notice-code="<%= notice.notice_code %>" style="flex:0.8;white-space:nowrap;">Anexar</button>
                              <% } %>
                            </div>
                            <% if (hasPermission('notices.inform')) { %>
                              <% if (notice.total_domains > 0 || notice.total_ips > 0) { %>
                                <button class="btn-info btn-inform-notice btn-action-compact" data-notice-id="<%= notice.id %>" data-notice-code="<%= notice.notice_code %>" style="background:var(--info);color:#fff;border-color:var(--info);width:100%;margin-top:4px;">Marcar Respondido</button>
                              <% } else { %>
                                <span style="color: var(--muted); font-size: 0.75rem; font-style: italic; margin-top: 4px;">Adicione alvos para responder</span>
                              <% } %>
                            <% } %>
                            <% if (!notice.status || notice.status === 'registered') { %>
                              <div style="display:flex;gap:4px;width:100%;margin-top:4px;">
                                <button class="btn-secondary btn-edit-notice btn-action-compact" 
                                        data-notice-id="<%= notice.id %>" 
                                        data-notice-code="<%= notice.notice_code %>"
                                        data-process-number="<%= notice.process_number || '' %>"
                                        data-requesting-organ="<%= notice.requesting_organ || '' %>"
                                        data-notice-name="<%= notice.original_file_name %>"
                                        data-block-start-date="<%= notice.block_start_date ? (d => `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`)(new Date(notice.block_start_date)) : '' %>"
                                        data-block-end-date="<%= notice.block_end_date ? (d => `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`)(new Date(notice.block_end_date)) : '' %>"
                                        data-notice-type="<%= notice.notice_type || 'block' %>"
                                        style="flex:1;">Editar</button>
                                <% if (hasPermission('notices.delete_full')) { %>
                                  <button class="btn-danger btn-delete-notice btn-action-compact" 
                                          data-notice-id="<%= notice.id %>" 
                                          data-notice-code="<%= notice.notice_code %>"
                                          style="flex:1;background:var(--danger);border-color:var(--danger);color:#fff;">Excluir</button>
                                <% } %>
                              </div>
                            <% } %>
                          </div>
                        <% } else { %>
                           <span style="color: var(--success); font-size: 0.9rem; font-weight: 700;">Ofício finalizado</span>
                           <div style="font-size: 0.75rem; color: var(--muted); line-height: 1.2;">
                             Por: <strong><%= notice.informer_username || 'Sistema' %></strong><br>
                             Em: <%= notice.informed_at ? new Date(notice.informed_at).toLocaleString('pt-BR') : '-' %>
                           </div>
                        <% } %>
                      </div>
                    </td>
                  </tr>
                <% }) %>
              <% } %>
            </tbody>
          </table>
        </div>

        <div class="table-pagination" id="notices-pagination" style="display: flex; align-items: center; justify-content: flex-end; gap: 12px; margin-top: 16px;">
          <button type="button" id="notices-prev" class="btn-secondary">Anterior</button>
          <span id="notices-page-info" style="font-size: 0.9rem; font-weight: 600; color: var(--muted);">Página 1 de 1</span>
          <button type="button" id="notices-next" class="btn-secondary">Próxima</button>
        </div>
      </section>
    </main>

    <!-- Modal para adicionar domínios ao ofício -->
    <div id="modal-add-domains" class="modal" style="display:none;position:fixed;z-index:2000;left:0;top:0;width:100vw;height:100vh;background:rgba(0,0,0,0.35);align-items:center;justify-content:center;">
      <div class="modal-content" style="background:#fff;padding:32px 28px;border-radius:16px;width:95%;max-width:900px;max-height:90vh;overflow-y:auto;box-shadow:var(--shadow-lg);position:relative;animation:modalIn 0.3s cubic-bezier(0.16, 1, 0.3, 1);">
        <button id="close-modal-add-domains" style="position:absolute;top:16px;right:20px;background:none;border:none;font-size:1.8rem;cursor:pointer;color:var(--muted);">&times;</button>
        
        <div style="margin-bottom: 24px;">
