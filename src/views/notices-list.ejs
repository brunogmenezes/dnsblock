        <h3 style="margin:0 0 12px; font-size:1.3rem;">Extração Concluída</h3>
        <p style="margin:0 0 16px; color:var(--muted); font-size:0.9rem;">
          Selecione os domínios encontrados no PDF que deseja adicionar à lista:
        </p>
        
        <div class="pdf-review-list" id="pdf-domains-container"></div>

        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
          <label style="display: flex; align-items: center; gap: 8px; cursor: pointer; font-size: 0.85rem; font-weight:600;">
            <input type="checkbox" id="pdf-select-all" checked /> Selecionar Todos
          </label>
          <span id="pdf-count-info" style="font-size: 0.8rem; font-weight: 700; color: var(--brand);">0 selecionados</span>
        </div>

        <div style="display:flex; gap:12px; justify-content:flex-end; border-top:1px solid var(--line); padding-top:20px;">
          <button type="button" class="btn-secondary" onclick="closePdfModal()" style="padding:8px 16px; font-size:0.9rem;">Cancelar</button>
          <button type="button" class="btn-primary" id="btn-transfer-pdf" style="padding:8px 20px; font-size:0.9rem; background:var(--success);">Adicionar à Lista</button>
        </div>
      </div>
    </div>

    <script>
      // ============================================================
      // MODAL CONFIRM personalizado (evita bloqueio do confirm() nativo)
      // ============================================================
      (function() {
        var _confirmCallback = null;
        var modalConfirm = document.getElementById('modal-confirm');
        var confirmTitle = document.getElementById('modal-confirm-title');
        var confirmMsg = document.getElementById('modal-confirm-message');
        var confirmOk = document.getElementById('modal-confirm-ok');
        var confirmCancel = document.getElementById('modal-confirm-cancel');

        function showConfirm(title, message, okLabel, callback) {
          confirmTitle.textContent = title;
          confirmMsg.textContent = message;
          confirmOk.textContent = okLabel || 'Excluir';
          _confirmCallback = callback;
          modalConfirm.style.display = 'flex';
        }

        function hideConfirm() {
          modalConfirm.style.display = 'none';
          _confirmCallback = null;
        }

        confirmOk.addEventListener('click', function() {
          var cb = _confirmCallback;
          hideConfirm();
          if (cb) cb();
        });
        confirmCancel.addEventListener('click', hideConfirm);
        modalConfirm.addEventListener('click', function(e) {
          if (e.target === modalConfirm) hideConfirm();
        });

        window.showConfirm = showConfirm;
      })();

      // ============================================================
      // DELEGAÇÃO DE CLIQUES - registrada primeiro para ser robusta
      // ============================================================
      document.addEventListener('click', function(e) {
        // Editar ofício
        const editBtn = e.target.closest('.btn-edit-notice');
        if (editBtn) {
          e.stopPropagation();
          const noticeId = editBtn.getAttribute('data-notice-id');
          const noticeCode = editBtn.getAttribute('data-notice-code');
          const processNumber = editBtn.getAttribute('data-process-number');
          const requestingOrgan = editBtn.getAttribute('data-requesting-organ');
          const noticeName = editBtn.getAttribute('data-notice-name');
          const blockStartDate = editBtn.getAttribute('data-block-start-date');
          const blockEndDate = editBtn.getAttribute('data-block-end-date');
          const noticeType = editBtn.getAttribute('data-notice-type');

          const form = document.getElementById('form-edit-notice');
          if (form) form.action = '/notices/' + noticeId + '/edit';
          const setVal = function(id, val) { const el = document.getElementById(id); if (el) el.value = val || ''; };
          setVal('editNoticeCode', noticeCode);
          setVal('editProcessNumber', processNumber);
          setVal('editRequestingOrgan', requestingOrgan);
          setVal('editNoticeName', noticeName);
          setVal('editBlockStartDate', blockStartDate);
          setVal('editBlockEndDate', blockEndDate);
          const typeBlock = document.getElementById('editNoticeTypeBlock');
          const typeUnblock = document.getElementById('editNoticeTypeUnblock');
          if (noticeType === 'unblock') { if (typeUnblock) typeUnblock.checked = true; }
          else { if (typeBlock) typeBlock.checked = true; }
          const modal = document.getElementById('modal-edit-notice');
          if (modal) modal.style.display = 'flex';
          return;
        }

        // Excluir ofício
        const deleteBtn = e.target.closest('.btn-delete-notice');
        if (deleteBtn) {
          e.stopPropagation();
          const noticeId = deleteBtn.getAttribute('data-notice-id');
          const noticeCode = deleteBtn.getAttribute('data-notice-code');
          window.showConfirm(
            'Excluir Ofício',
            'Deseja realmente excluir o ofício "' + noticeCode + '"? Esta ação removerá permanentemente o ofício, seus anexos e domínios vinculados.',
            'Excluir',
            function() {
              const form = document.createElement('form');
              form.method = 'POST';
              form.action = '/notices/' + noticeId + '/delete';
              document.body.appendChild(form);
              form.submit();
            }
          );
          return;
        }

        // Excluir anexo individual
        const deleteFileBtn = e.target.closest('.btn-delete-file');
        if (deleteFileBtn) {
          e.stopPropagation();
          const noticeId = deleteFileBtn.getAttribute('data-notice-id');
          const fileId = deleteFileBtn.getAttribute('data-file-id');
          const fileName = deleteFileBtn.getAttribute('data-file-name');
          window.showConfirm(
            'Excluir Anexo',
            'Deseja excluir o anexo "' + fileName + '"? Esta ação não pode ser desfeita.',
            'Excluir',
            function() {
              fetch('/notices/' + noticeId + '/files/' + fileId + '/delete', { method: 'POST' })
                .then(function(r) { return r.json(); })
                .then(function(data) {
                  if (data.success) {
                    const span = deleteFileBtn.closest('span');
                    if (span) span.remove();
                  } else {
                    alert(data.error || 'Erro ao excluir anexo.');
                  }
                })
                .catch(function() { alert('Erro de comunicação ao excluir anexo.'); });
            }
          );
          return;
        }

        // Fechar modal de edição clicando fora
        const mEdit = document.getElementById('modal-edit-notice');
        if (mEdit && e.target === mEdit) {
          mEdit.style.display = 'none';
          const fe = document.getElementById('form-edit-notice');
          if (fe) fe.reset();
        }

        // Fechar modal de cadastro clicando fora
        const mAdd = document.getElementById('modal-add-notice');
        if (mAdd && e.target === mAdd) {
          mAdd.style.display = 'none';
          const fa = document.getElementById('form-add-notice');
          if (fa) fa.reset();
        }
      });

      // ============================================================
      // FIM DA DELEGAÇÃO - restante do script abaixo
      // ============================================================

            const IP_REGEX_V4 = /^(?:25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\.(?:25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\.(?:25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\.(?:25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)$/;
            const IP_REGEX_V6 = /^(?:[A-F0-9]{1,4}:){7}[A-F0-9]{1,4}$|^(?:[A-F0-9]{1,4}:){1,7}:|^(?:[A-F0-9]{1,4}:){1,6}:[A-F0-9]{1,4}$|^(?:[A-F0-9]{1,4}:){1,5}(?::[A-F0-9]{1,4}){1,2}$|^(?:[A-F0-9]{1,4}:){1,4}(?::[A-F0-9]{1,4}){1,3}$|^(?:[A-F0-9]{1,4}:){1,3}(?::[A-F0-9]{1,4}){1,4}$|^(?:[A-F0-9]{1,4}:){1,2}(?::[A-F0-9]{1,4}){1,5}$|^[A-F0-9]{1,4}:(?::[A-F0-9]{1,4}){1,6}$|^:(?::[A-F0-9]{1,4}){1,7}$|^:$/i;


            const modalAddDomains = document.getElementById('modal-add-domains');
            const closeModalAddDomains = document.getElementById('close-modal-add-domains');
            const cancelModalAddDomains = document.getElementById('cancel-modal-add-domains');
            const formAddDomains = document.getElementById('form-add-domains');
            const inputNoticeId = document.getElementById('input-notice-id');
            const inputDomains = document.getElementById('input-domains');
            const modalNoticeCode = document.getElementById('modal-notice-code');

            const statValid = document.getElementById('stat-valid');
            const statInvalid = document.getElementById('stat-invalid');
            const statExists = document.getElementById('stat-exists');
            const statTotal = document.getElementById('stat-total');

            // IP Modal Elements
            const modalAddIps = document.getElementById('modal-add-ips');
            const closeModalAddIps = document.getElementById('close-modal-add-ips');
            const cancelModalAddIps = document.getElementById('cancel-modal-add-ips');
            const formAddIps = document.getElementById('form-add-ips');
            const inputIpsNoticeId = document.getElementById('input-ips-notice-id');
            const inputIps = document.getElementById('input-ips');
            const modalIpsNoticeCode = document.getElementById('modal-ips-notice-code');
            const statIpsValid = document.getElementById('stat-ips-valid');
            const statIpsInvalid = document.getElementById('stat-ips-invalid');
            const statIpsExists = document.getElementById('stat-ips-exists');
            const statIpsTotal = document.getElementById('stat-ips-total');

            let validationTimeout;
            let validationIpsTimeout;

            const DOMAIN_REGEX = /^(?=.{1,253}$)(?!.*\.\.)(?:[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?\.)+[a-zA-Z]{2,63}$/;

            function normalizeDomainLocal(domain) {
              if (!domain || typeof domain !== 'string') return '';
              return domain.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().replace(/\s+/g, '').trim();
            }

            async function validateDomains() {
              const text = inputDomains.value;
              const lines = text.split(/\r?\n/).map(l => l.trim()).filter(Boolean);
              
              let validCount = 0;
              let invalidCount = 0;
              let totalCount = lines.length;
              const validList = [];
              
              lines.forEach(line => {
                const norm = normalizeDomainLocal(line);
                if (norm && DOMAIN_REGEX.test(norm)) {
                  validCount++;
                  validList.push(norm);
                } else {
                  invalidCount++;
                }
              });

              statValid.textContent = validCount;
              statInvalid.textContent = invalidCount;
              
              // O total inicial (enquanto não carrega os existentes) é o de válidos
              statTotal.textContent = validCount;

              if (validList.length > 0) {
                try {
                  const res = await fetch('/domains/check-exists', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ domains: validList })
                  });
                  const data = await res.json();
                  const registeredCount = data.registered ? data.registered.length : 0;
                  statExists.textContent = registeredCount;
                  
                  // Atualiza o total subtraindo os já cadastrados
                  statTotal.textContent = validCount - registeredCount;
                } catch (e) {
                  statExists.textContent = '0';
                  statTotal.textContent = validCount;
                }
              } else {
                statExists.textContent = '0';
                statTotal.textContent = '0';
              }
            }

            inputDomains.oninput = function() {
              clearTimeout(validationTimeout);
              validationTimeout = setTimeout(validateDomains, 400);
            };

            const modalResultDomains = document.getElementById('modal-result-domains');
            const resultNoticeCode = document.getElementById('result-notice-code');
            const resultValid = document.getElementById('result-valid');
            const resultInvalid = document.getElementById('result-invalid');
            const resultExists = document.getElementById('result-exists');
            const btnOkResult = document.getElementById('btn-ok-result');

            formAddDomains.onsubmit = async function(e) {
              e.preventDefault();
              
              const noticeId = inputNoticeId.value;
              const domains = inputDomains.value;
              const noticeCode = modalNoticeCode.textContent;

              const submitBtn = formAddDomains.querySelector('button[type="submit"]');
              const originalBtnText = submitBtn.textContent;
              submitBtn.textContent = 'Aguarde...';
              submitBtn.disabled = true;

              try {
                const response = await fetch('/notices/add-domains', {
                  method: 'POST',
                  headers: {
                    'Content-Type': 'application/json'
                  },
                  body: JSON.stringify({ noticeId, domains })
                });

                const data = await response.json();

                if (!response.ok) {
                  showAppAlert('Não permitido', data.error || 'Erro ao inserir domínios.');
                  submitBtn.textContent = originalBtnText;
                  submitBtn.disabled = false;
                  return;
                }

                // Esconde modal de cadastro
                modalAddDomains.style.display = 'none';
                formAddDomains.reset();

                // Mostra modal de resultado
                resultNoticeCode.textContent = noticeCode;
                resultValid.textContent = data.validCount || 0;
                resultInvalid.textContent = data.invalidCount || 0;
                resultExists.textContent = data.registeredCount || 0;
                
                const resultValidLabel = document.getElementById('result-valid-label');
                if (data.noticeType === 'unblock') {
                  resultValidLabel.textContent = 'Válidos Desbloqueados:';
                } else {
                  resultValidLabel.textContent = 'Válidos Inseridos:';
                }

                modalResultDomains.style.display = 'flex';

              } catch (error) {
                showAppAlert('Erro', 'Erro na comunicação com o servidor.');
              } finally {
                submitBtn.textContent = originalBtnText;
                submitBtn.disabled = false;
              }
            };

            btnOkResult.onclick = function() {
              modalResultDomains.style.display = 'none';
              window.location.reload();
            };

            document.querySelectorAll('.btn-add-domains').forEach(btn => {
              btn.onclick = function() {
                const noticeId = btn.getAttribute('data-notice-id');
                const noticeCode = btn.getAttribute('data-notice-code');
                const noticeType = btn.getAttribute('data-notice-type') || 'block';
                
                inputNoticeId.value = noticeId;
                modalNoticeCode.textContent = noticeCode;
                inputDomains.value = '';
                statValid.textContent = '0';
                statInvalid.textContent = '0';
                statExists.textContent = '0';
                statTotal.textContent = '0';
                
                // Ajusta textos do modal baseado no tipo de ofício
                const modalTitle = document.getElementById('modal-add-domains-title');
                const labelDomains = document.getElementById('label-input-domains');
                const btnSubmit = document.getElementById('btn-submit-domains');
                const statValidLabel = document.getElementById('stat-valid-label');
                const statTotalLabel = document.getElementById('stat-total-label');

                if (noticeType === 'unblock') {
                  modalTitle.textContent = 'Desbloquear Domínios via Ofício';
                  labelDomains.innerHTML = 'Domínios para desbloquear <span style="font-weight:400;color:var(--muted);">(procurará na base atual)</span>';
                  btnSubmit.textContent = 'Desbloquear Domínios';
                  btnSubmit.className = 'btn-primary';
                  btnSubmit.style.background = 'var(--info)';
                  btnSubmit.style.borderColor = 'var(--info)';
                  statValidLabel.textContent = 'Para Desbloquear';
                  statTotalLabel.textContent = 'Total a Liberar';
                } else {
                  modalTitle.textContent = 'Adicionar Domínios ao Ofício';
                  labelDomains.innerHTML = 'Domínios para bloquear <span style="font-weight:400;color:var(--muted);">(um por linha)</span>';
                  btnSubmit.textContent = 'Bloquear Domínios';
                  btnSubmit.className = 'btn-primary';
                  btnSubmit.style.background = '';
                  btnSubmit.style.borderColor = '';
                  statValidLabel.textContent = 'Válidos';
                  statTotalLabel.textContent = 'Total';
                }

                modalAddDomains.style.display = 'flex';
                setTimeout(() => inputDomains.focus(), 100);
                
                // Busca arquivos anexados
                loadNoticeFiles(noticeId);
              };
            });
            closeModalAddDomains.onclick = cancelModalAddDomains.onclick = function() {
              modalAddDomains.style.display = 'none';
              formAddDomains.reset();
            };

            // --- IP Management Logic ---
            function isValidIPLocal(ip) {
              return IP_REGEX_V4.test(ip) || IP_REGEX_V6.test(ip);
            }

            async function validateIps() {
              const text = inputIps.value;
              const lines = text.split(/\r?\n/).map(l => l.trim()).filter(Boolean);
              
              let validCount = 0;
              let invalidCount = 0;
              const validList = [];
              
              lines.forEach(line => {
                if (isValidIPLocal(line)) {
                  validCount++;
                  validList.push(line);
                } else {
                  invalidCount++;
                }
              });

              statIpsValid.textContent = validCount;
              statIpsInvalid.textContent = invalidCount;
              statIpsTotal.textContent = validCount;

              if (validList.length > 0) {
                try {
                  const res = await fetch('/ips/check-exists', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ ips: validList })
                  });
                  const data = await res.json();
                  const registeredCount = data.registered ? data.registered.length : 0;
                  statIpsExists.textContent = registeredCount;
                  statIpsTotal.textContent = validCount - registeredCount;
                } catch (e) {
                  statIpsExists.textContent = '0';
                  statIpsTotal.textContent = validCount;
                }
              } else {
                statIpsExists.textContent = '0';
                statIpsTotal.textContent = '0';
              }
            }

            inputIps.oninput = function() {
              clearTimeout(validationIpsTimeout);
              validationIpsTimeout = setTimeout(validateIps, 400);
            };

            const modalResultIps = document.getElementById('modal-result-ips');
            const resultIpsNoticeCode = document.getElementById('result-ips-notice-code');
            const resultIpsValid = document.getElementById('result-ips-valid');
            const resultIpsInvalid = document.getElementById('result-ips-invalid');
            const resultIpsExists = document.getElementById('result-ips-exists');
            const btnOkResultIps = document.getElementById('btn-ok-result-ips');

            formAddIps.onsubmit = async function(e) {
              e.preventDefault();
              
              const noticeId = inputIpsNoticeId.value;
              const ips = inputIps.value;
              const noticeCode = modalIpsNoticeCode.textContent;

              const submitBtn = formAddIps.querySelector('button[type="submit"]');
              const originalBtnText = submitBtn.textContent;
              submitBtn.textContent = 'Aguarde...';
              submitBtn.disabled = true;

              try {
                const response = await fetch('/notices/add-ips', {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify({ noticeId, ips })
                });

                const data = await response.json();

                if (!response.ok) {
                  showAppAlert('Não permitido', data.error || 'Erro ao inserir IPs.');
                  submitBtn.textContent = originalBtnText;
                  submitBtn.disabled = false;
                  return;
                }

                modalAddIps.style.display = 'none';
                formAddIps.reset();

                resultIpsNoticeCode.textContent = noticeCode;
                resultIpsValid.textContent = data.validCount || 0;
                resultIpsInvalid.textContent = data.invalidCount || 0;
                resultIpsExists.textContent = data.registeredCount || 0;
                
                const resultIpsValidLabel = document.getElementById('result-ips-valid-label');
                if (data.noticeType === 'unblock') {
                  resultIpsValidLabel.textContent = 'Válidos Desbloqueados:';
                } else {
                  resultIpsValidLabel.textContent = 'Válidos Inseridos:';
                }

                modalResultIps.style.display = 'flex';

              } catch (error) {
                showAppAlert('Erro', 'Erro na comunicação com o servidor.');
              } finally {
                submitBtn.textContent = originalBtnText;
                submitBtn.disabled = false;
              }
            };

            btnOkResultIps.onclick = function() {
              modalResultIps.style.display = 'none';
              window.location.reload();
            };

            document.querySelectorAll('.btn-add-ips').forEach(btn => {
              btn.onclick = function() {
                const noticeId = btn.getAttribute('data-notice-id');
                const noticeCode = btn.getAttribute('data-notice-code');
                const noticeType = btn.getAttribute('data-notice-type') || 'block';
                
                inputIpsNoticeId.value = noticeId;
                modalIpsNoticeCode.textContent = noticeCode;
                inputIps.value = '';
                statIpsValid.textContent = '0';
                statIpsInvalid.textContent = '0';
                statIpsExists.textContent = '0';
                statIpsTotal.textContent = '0';
                
                const modalTitle = document.getElementById('modal-ips-title');
                const instructions = document.getElementById('modal-ips-instructions');
                const btnSubmit = document.getElementById('btn-submit-ips');
                const statValidLabel = document.getElementById('stat-ips-valid-label');

                if (noticeType === 'unblock') {
                  modalTitle.textContent = 'Desbloquear IPs via Ofício';
                  instructions.innerHTML = 'Cole os IPs para desbloquear <span style="font-weight:400;color:var(--muted);">(procurará na base atual)</span>';
                  btnSubmit.textContent = 'Desbloquear IPs';
                  btnSubmit.style.background = 'var(--info)';
                  btnSubmit.style.borderColor = 'var(--info)';
                  statValidLabel.textContent = 'Para Desbloquear';
                } else {
                  modalTitle.textContent = 'Adicionar IPs ao Ofício';
                  instructions.innerHTML = 'IPs para bloquear <span style="font-weight:400;color:var(--muted);">(um por linha)</span>';
                  btnSubmit.textContent = 'Bloquear IPs';
                  btnSubmit.style.background = '#6366f1';
                  btnSubmit.style.borderColor = '#6366f1';
                  statValidLabel.textContent = 'Válidos';
                }

                modalAddIps.style.display = 'flex';
                setTimeout(() => inputIps.focus(), 100);
              };
            });

            closeModalAddIps.onclick = cancelModalAddIps.onclick = function() {
              modalAddIps.style.display = 'none';
              formAddIps.reset();
            };

            // --- PDF Extraction Logic ---
            const modalPdfReview = document.getElementById('modal-pdf-review');
            const pdfLoadingOverlay = document.getElementById('pdf-loading-overlay');
            const pdfDomainsContainer = document.getElementById('pdf-domains-container');
            const pdfCountInfo = document.getElementById('pdf-count-info');
            const pdfSelectAll = document.getElementById('pdf-select-all');
            const btnTransferPdf = document.getElementById('btn-transfer-pdf');

            function updatePdfCountLocal() {
              const checked = document.querySelectorAll('.pdf-domain-item input[type="checkbox"]:checked');
              const total = document.querySelectorAll('.pdf-domain-item input[type="checkbox"]');
              pdfCountInfo.textContent = `${checked.length} selecionados`;
              pdfSelectAll.checked = checked.length === total.length && total.length > 0;
            }

            pdfSelectAll.onchange = function() {
              const checked = this.checked;
              document.querySelectorAll('.pdf-domain-item input[type="checkbox"]').forEach(cb => cb.checked = checked);
              updatePdfCountLocal();
            };

            function closePdfModal() {
              modalPdfReview.style.display = 'none';
            }

            btnTransferPdf.onclick = function() {
              const selectedDomains = Array.from(document.querySelectorAll('.pdf-domain-item input[type="checkbox"]:checked'))
                .map(cb => cb.value);

              if (selectedDomains.length > 0) {
                const currentText = inputDomains.value.trim();
                const newText = selectedDomains.join('\n');
                inputDomains.value = currentText ? currentText + '\n' + newText : newText;
                
                // Dispara a validação automática que já existe no modal
                validateDomains();
                closePdfModal();
              }
            };

            window.closePdfModal = closePdfModal;

            async function loadNoticeFiles(noticeId) {
              const section = document.getElementById('notice-files-section');
              const list = document.getElementById('notice-files-list');
              
              section.style.display = 'none';
              list.innerHTML = '';

              try {
                const res = await fetch(`/api/notices/${noticeId}/files`);
                const files = await res.json();
                
                const extractableFiles = files.filter(f => 
                  f.mime_type === 'application/pdf' || 
                  f.original_file_name.toLowerCase().endsWith('.xlsx') ||
                  f.mime_type === 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet'
                );
                
                if (extractableFiles.length > 0) {
                  section.style.display = 'block';
                  list.innerHTML = extractableFiles.map(f => {
                    const isPdf = f.mime_type === 'application/pdf';
                    const iconColor = isPdf ? 'red' : 'green';
                    const icon = isPdf 
                      ? '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline>'
                      : '<rect x="4" y="2" width="16" height="20" rx="2" ry="2"></rect><line x1="8" y1="18" x2="8" y2="8"></line><line x1="12" y1="18" x2="12" y2="8"></line><line x1="16" y1="18" x2="16" y2="8"></line>';
                    
                    return `
                      <div style="display:flex; justify-content: space-between; align-items: center; background:#fff; padding: 10px 14px; border-radius: 8px; border:1px solid var(--line);">
                        <div style="display:flex; align-items: center; gap: 10px; overflow: hidden;">
                          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="${iconColor}" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">${icon}</svg>
                          <span style="font-size: 0.9rem; font-weight: 500; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">${f.original_file_name}</span>
                        </div>
                        <button type="button" onclick="extractFromAttachment(${f.id})" class="btn-primary" style="padding: 4px 10px; font-size: 0.75rem; background: var(--brand);">Extrair</button>
                      </div>
                    `;
                  }).join('');
                }
              } catch (e) {
                console.error('Erro ao carregar arquivos:', e);
              }
            }

            async function extractFromAttachment(fileId) {
              const btn = event.target;
              const originalText = btn.textContent;
              btn.disabled = true;
              btn.textContent = 'Extraindo...';

              modalPdfReview.style.display = 'flex';
              pdfLoadingOverlay.style.display = 'flex';
              pdfDomainsContainer.innerHTML = '';
              btnTransferPdf.disabled = true;

              try {
                const res = await fetch('/api/domains/extract-from-attachment', {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify({ fileId })
                });
                let data;
                try {
                  data = await res.json();
                } catch (jsonErr) {
                  throw new Error('O servidor retornou uma resposta inválida.');
                }

                if (data.success) {
                  if (data.domains.length === 0) {
                    pdfDomainsContainer.innerHTML = '<div style="padding: 20px; text-align: center; color: var(--muted);">Nenhum domínio encontrado neste anexo.</div>';
                  } else {
                    pdfDomainsContainer.innerHTML = data.domains.map((domain, index) => `
                      <div class="pdf-domain-item">
                        <input type="checkbox" id="pdf-dom-att-${index}" value="${domain}" checked onchange="updatePdfCountLocal()" />
                        <label for="pdf-dom-att-${index}">${domain}</label>
                      </div>
                    `).join('');
                    btnTransferPdf.disabled = false;
                  }
                  updatePdfCountLocal();
                } else {
                  throw new Error(data.error || 'Erro ao extrair domínios.');
                }
              } catch (err) {
                showAppAlert('Erro de Extração', err.message);
                closePdfModal();
              } finally {
                pdfLoadingOverlay.style.display = 'none';
                if (btn) {
                  btn.disabled = false;
                  btn.textContent = originalText;
                }
              }
            }

            window.extractFromAttachment = extractFromAttachment;

            // Modal de marcar como informado
            const modalInformNotice = document.getElementById('modal-inform-notice');
            const closeModalInformNotice = document.getElementById('close-modal-inform-notice');
            const cancelModalInformNotice = document.getElementById('cancel-modal-inform-notice');
            const formInformNotice = document.getElementById('form-inform-notice');
            const inputInformNoticeId = document.getElementById('input-inform-notice-id');
            const inputInformedAt = document.getElementById('input-informed-at');
            const modalInformNoticeCode = document.getElementById('modal-inform-notice-code');

            document.querySelectorAll('.btn-inform-notice').forEach(btn => {
              btn.onclick = function() {
                inputInformNoticeId.value = btn.getAttribute('data-notice-id');
                modalInformNoticeCode.textContent = btn.getAttribute('data-notice-code');
                
                // Preenche com a data/hora atual por padrão
                const now = new Date();
                const offset = now.getTimezoneOffset() * 60000;
                const localISOTime = (new Date(now - offset)).toISOString().slice(0, 16);
                inputInformedAt.value = localISOTime;

                modalInformNotice.style.display = 'flex';
              };
            });

            closeModalInformNotice.onclick = cancelModalInformNotice.onclick = function() {
              modalInformNotice.style.display = 'none';
              formInformNotice.reset();
            };

            formInformNotice.onsubmit = async function(e) {
              e.preventDefault();
              const noticeId = inputInformNoticeId.value;
              const informedAt = inputInformedAt.value;

              const submitBtn = formInformNotice.querySelector('button[type="submit"]');
              const originalBtnText = submitBtn.textContent;
              submitBtn.textContent = 'Enviando...';
              submitBtn.disabled = true;

              try {
                const response = await fetch(`/notices/${noticeId}/inform`, {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify({ informedAt })
                });

                if (response.ok) {
                  window.location.reload();
                } else {
                  const data = await response.json();
                  showAppAlert('Não permitido', data.error || 'Erro ao atualizar status do ofício.');
                }
              } catch (error) {
                showAppAlert('Erro', 'Erro na comunicação com o servidor.');
              } finally {
                submitBtn.textContent = originalBtnText;
                submitBtn.disabled = false;
              }
            };

            // Função Global para Alertas
            const modalAppAlert = document.getElementById('modal-alert');
            const modalAlertTitle = document.getElementById('modal-alert-title');
            const modalAlertMessage = document.getElementById('modal-alert-message');
            const btnAlertOk = document.getElementById('btn-alert-ok');

            function showAppAlert(title, message) {
              modalAlertTitle.textContent = title;
              modalAlertMessage.textContent = message;
              modalAppAlert.style.display = 'flex';
            }

            btnAlertOk.onclick = function() {
              modalAppAlert.style.display = 'none';
            };

            window.showAppAlert = showAppAlert;

            // Modal de anexar arquivos
            const modalAddFiles = document.getElementById('modal-add-files');
            const closeModalAddFiles = document.getElementById('close-modal-add-files');
            const cancelModalAddFiles = document.getElementById('cancel-modal-add-files');
            const formAddFiles = document.getElementById('form-add-files');
            const inputFileNoticeId = document.getElementById('input-file-notice-id');
            const modalFileNoticeCode = document.getElementById('modal-file-notice-code');
            document.querySelectorAll('.btn-add-files').forEach(btn => {
              btn.onclick = function() {
                inputFileNoticeId.value = btn.getAttribute('data-notice-id');
                modalFileNoticeCode.textContent = btn.getAttribute('data-notice-code');
                modalAddFiles.style.display = 'flex';
              };
            });
            closeModalAddFiles.onclick = cancelModalAddFiles.onclick = function() {
              modalAddFiles.style.display = 'none';
              formAddFiles.reset();
            };

            window.addEventListener('click', function(event) {
              if (event.target === modalAddDomains) {
                modalAddDomains.style.display = 'none';
                formAddDomains.reset();
              }
              if (event.target === modalAddFiles) {
                modalAddFiles.style.display = 'none';
                formAddFiles.reset();
              }
              if (event.target === modalInformNotice) {
                modalInformNotice.style.display = 'none';
                formInformNotice.reset();
              }
            });
      // Busca instantânea com debounce
      const searchInput = document.getElementById('search-input');
      const searchForm = searchInput && searchInput.form;
      let debounceTimeout;
      if (searchInput && searchForm) {
        searchInput.addEventListener('input', function() {
          clearTimeout(debounceTimeout);
          debounceTimeout = setTimeout(() => {
            // Marca para restaurar foco após reload
            try { localStorage.setItem('focusSearchInput', '1'); } catch(e){}
            searchForm.submit();
          }, 400);
        });
        // Restaura foco se marcado
        window.addEventListener('DOMContentLoaded', function() {
          try {
            if (localStorage.getItem('focusSearchInput') === '1') {
              searchInput.focus();
              searchInput.selectionStart = searchInput.value.length;
              localStorage.removeItem('focusSearchInput');
            }
          } catch(e){}
        });
      }
      // Modal de cadastro de ofício
      const btnAddNotice = document.getElementById('btn-add-notice');
      const modalAddNotice = document.getElementById('modal-add-notice');
      const closeModalAddNotice = document.getElementById('close-modal-add-notice');
      const cancelModalAddNotice = document.getElementById('cancel-modal-add-notice');

      if (btnAddNotice) {
        btnAddNotice.onclick = function() {
          modalAddNotice.style.display = 'flex';
        };
      }
      if (closeModalAddNotice && cancelModalAddNotice) {
        closeModalAddNotice.onclick = cancelModalAddNotice.onclick = function() {
          modalAddNotice.style.display = 'none';
          document.getElementById('form-add-notice').reset();
        };
      }

      // Modal de edição de ofício
      const modalEditNotice = document.getElementById('modal-edit-notice');
      const closeModalEditNotice = document.getElementById('close-modal-edit-notice');
      const cancelModalEditNotice = document.getElementById('cancel-modal-edit-notice');

      if (closeModalEditNotice && cancelModalEditNotice) {
        closeModalEditNotice.onclick = cancelModalEditNotice.onclick = function() {
          modalEditNotice.style.display = 'none';
          document.getElementById('form-edit-notice').reset();
        };
      }




      // Paginação Cliente-side para Ofícios
      (function() {
        const tbody = document.getElementById('notices-body');
        const allRows = Array.from(tbody.querySelectorAll('tr.data-row'));
        const pageSizeSelect = document.getElementById('notices-page-size');
        const prevBtn = document.getElementById('notices-prev');
        const nextBtn = document.getElementById('notices-next');
        const pageInfo = document.getElementById('notices-page-info');

        let currentPage = 1;
        let pageSize = parseInt(pageSizeSelect.value) || 5;

        function updatePagination() {
          const totalRows = allRows.length;
          const totalPages = Math.max(1, Math.ceil(totalRows / pageSize));
          
          if (currentPage > totalPages) currentPage = totalPages;
          if (currentPage < 1) currentPage = 1;

          const start = (currentPage - 1) * pageSize;
          const end = start + pageSize;

          allRows.forEach((row, index) => {
            row.style.display = (index >= start && index < end) ? '' : 'none';
          });

          pageInfo.textContent = `Página ${currentPage} de ${totalPages} (${totalRows} registros)`;
          prevBtn.disabled = currentPage <= 1;
          nextBtn.disabled = currentPage >= totalPages;
        }

        pageSizeSelect.onchange = function() {
          pageSize = parseInt(this.value);
          currentPage = 1;
          updatePagination();
        };

        prevBtn.onclick = function() {
          if (currentPage > 1) {
            currentPage--;
            updatePagination();
          }
        };

        nextBtn.onclick = function() {
          const totalPages = Math.ceil(allRows.length / pageSize);
          if (currentPage < totalPages) {
            currentPage++;
            updatePagination();
          }
        };

        updatePagination();
      })();
    </script>
    </div> <!-- .main-content -->
  </body>
</html>
